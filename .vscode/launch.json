{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "\u9879\u76ee\u72b6\u6001",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "--sdk-child",
        "-m",
        "social_navigation",
        "status"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
      },
      "program": "${workspaceFolder}/scripts/run_external_python.py"
    },
    {
      "name": "\u573a\u666f\u8d44\u6e90\u68c0\u67e5",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "--sdk-child",
        "-m",
        "social_navigation",
        "preflight",
        "--scene",
        "${input:scene}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
      },
      "program": "${workspaceFolder}/scripts/run_external_python.py"
    },
    {
      "name": "PointGoal PPO \u53c2\u6570",
      "type": "debugpy",
      "request": "launch",
      "args": [
        "--sdk-child",
        "-m",
        "social_navigation",
        "baseline-train",
        "--help"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}"
      },
      "program": "${workspaceFolder}/scripts/run_external_python.py"
    }
  ],
  "inputs": [
    {
      "id": "scene",
      "type": "pickString",
      "description": "\u9009\u62e9\u573a\u666f",
      "options": [
        "YOHO",
        "NewMetro",
        "SecondFloor",
        "ThirdFloor"
      ],
      "default": "YOHO"
    }
  ]
}
