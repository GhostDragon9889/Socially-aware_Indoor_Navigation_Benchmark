+"""Preflight for the migrated NavDP standalone scripts, before Kit is loaded.
+
+The archived requirements.txt describes the original Lab 2 environment. Keep it
+isolated from the primary Lab 3 / Sim 6.1 runtime. This preflight verifies the
+runtime family; it does not certify full navigation or external model assets.
+"""
+import importlib.metadata
+import importlib.util
+import sys
+
+
+def require_supported_runtime(*, python_version=None, version_lookup=None):
+    python_version = sys.version_info if python_version is None else python_version
+    version_lookup = importlib.metadata.version if version_lookup is None else version_lookup
+    prefix = (
+        "NavDP standalone simulation requires the project Isaac Lab 3.0 EA / Isaac Sim 6.1 "
+        "Python 3.12 environment. Activate that environment; do not install the archived "
+        "third_party/navdp/requirements.txt into the main runtime. "
+    )
+    if tuple(python_version[:2]) != (3, 12):
+        raise RuntimeError(prefix + f"Found Python {python_version[0]}.{python_version[1]}.")
+    try:
+        sim_version = version_lookup("isaacsim")
+        lab_version = version_lookup("isaaclab")
+    except importlib.metadata.PackageNotFoundError as exc:
+        raise RuntimeError(prefix + f"Missing installed package: {exc.name}.") from exc
+    if tuple(sim_version.split(".")[:2]) != ("6", "1"):
+        raise RuntimeError(prefix + f"Found Isaac Sim {sim_version}.")
+    # The target SDK's distribution version is 17.x; its repository VERSION is 3.0.0.
+    if lab_version.split(".")[0] != "17":
+        raise RuntimeError(prefix + f"Found isaaclab distribution {lab_version}; expected target SDK 17.x.")
+    return {"python": ".".join(map(str, python_version[:3])), "isaacsim": sim_version, "isaaclab_distribution": lab_version}
+
+
+def require_baseline_dependencies(*, teleop=False, module_lookup=None):
+    """Reject missing optional baseline packages before any Kit/GPU startup."""
+    module_lookup = importlib.util.find_spec if module_lookup is None else module_lookup
+    names = ["casadi", "pathfinding", "open3d", "cv2", "imageio", "requests", "rsl_rl", "torchvision", "scipy", "matplotlib"]
+    if teleop:
+        names.append("pynput")
+    missing = [name for name in names if module_lookup(name) is None]
+    if missing:
+        raise RuntimeError(
+            "Missing optional NavDP baseline modules: " + ", ".join(missing) + ". "
+            "Install compatible optional dependencies in the target SDK environment before launching "
+            "this baseline. Do not install its archived Lab 2 / NumPy 1 requirements into the main runtime."
+        )
+    return names
