include LICENSE.md README.md pyproject.toml FULL_PIPELINE.md
recursive-include legal *.txt
include requirements_*.txt
recursive-include src *.py *.md *.json *.yaml *.sh
include src/CrowdSim/humanoid/diffusion/LICENSE.trace
include src/CrowdSim/humanoid/diffusion/LICENSE.diffuser
recursive-include src/protomotions/data/assets *
recursive-include configs *.json *.yaml *.patch *.md
recursive-include data/navigation_maps *.png *.json
recursive-include examples/experiments *.py
recursive-include scripts *.py *.sh *.js
recursive-include tools *.py *.sh
recursive-include tests *.py *.js
recursive-include data/scripts *.py *.sh *.yaml
recursive-include packages *.toml *.md
include packages/crowdsim-ppo/LICENSE
recursive-include env/isaaclab3_sim6 *.toml *.lock *.json *.md
recursive-include env/isaaclab3_ea_sim61 *.toml *.lock *.json *.md *.txt
recursive-include docs *.md
recursive-include docs/migration_sim61_lab3ea_20261010 *.json *.xml *.txt *.gz
# Licensed SMPL body assets remain local and are never redistributed.
recursive-exclude src/protomotions/data/assets/mesh/smpl *
exclude src/protomotions/data/assets/mjcf/smpl*
recursive-exclude src/protomotions/data/assets/mjcf/smpl* *
exclude src/protomotions/data/assets/usd/smpl*
recursive-exclude src/protomotions/data/assets/usd/smpl* *
# Compatibility links and generated copies are not separate source packages.
prune protomotions
prune CrowdSim
prune deployment
prune build
prune src/build
prune src/dist
prune third_party
prune output
global-exclude __pycache__ *.py[cod]

include *.code-workspace
recursive-include .vscode *.json *.env
global-exclude *.local.json
